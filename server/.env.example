OPENAI_API_KEY=sk-your-api-key
OPENAI_MODEL=gpt-4o-mini
# Optional. Only set this if you use a compatible proxy or gateway.
# OPENAI_BASE_URL=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/task_web_demo?schema=public
# Optional. Useful for providers such as Supabase where pooled and direct connections differ.
# DIRECT_URL=postgresql://postgres:postgres@localhost:5432/task_web_demo
# Demo user used before real authentication is added.
# DEMO_USER_EMAIL=demo@task-web.local
# DEMO_USER_PASSWORD_HASH=local-demo-no-login
# DEMO_USER_NICKNAME=Demo User
AUTH_SECRET=replace-with-a-long-random-production-secret
CLIENT_ORIGIN=http://localhost:5173
ALLOW_DEMO_AUTH_FALLBACK=true
# Optional seed identity for migrating the current single-user JSON data into Postgres.
# SEED_USER_EMAIL=demo@task-web.local
# SEED_USER_PASSWORD_HASH=local-demo-no-login
# SEED_USER_NICKNAME=Demo User
